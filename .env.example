# Copy to .env on the server. Never commit the real key.
DEEPSEEK_API_KEY=replace_with_a_deepseek_key
STEPFUN_API_KEY=replace_with_a_stepfun_key
GENERATION_MODEL=deepseek-v4-flash
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_CONCURRENCY=10
EXPORT_CONCURRENCY=2
STEPFUN_MODEL=step-3.7-flash
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_FALLBACK_BASE_URL=https://api.stepfun.com/v1
STEPFUN_TIMEOUT=180
